# exclude all dot files except .git, appveyor and travis files
.*
!.git*
!.appveyor*
!.editorconfig
!.vscode
.vscode/*.db*

# exclude binaries and temporary files
[Bb]in/
[Bb]uild*/
# Prebuilt sentry-native for MSVC (misc/windows/build_sentry_native.ps1 or .sh); do not commit unless you intend to vendor binaries
sdk/sentry/

# User-specific files
*.user
*.user.props
*.nvuser
*.PVS-Studio.*

# Visual Studio profiler
*.psess
*.vsp
*.vspx

# exclude doxygen output
doc/doxygen/html/*
