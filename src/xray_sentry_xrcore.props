<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="16.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="xray_sentry.props" />
  <ItemDefinitionGroup Condition="'$(UseSentry)'=='true'">
    <ClCompile>
      <PreprocessorDefinitions>USE_SENTRY;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(SentryNativeRoot)include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalLibraryDirectories>$(SentryLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
    <Lib>
      <AdditionalLibraryDirectories>$(SentryLibraryDir);%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Lib>
  </ItemDefinitionGroup>
  <!-- Fail fast with a clear message instead of LNK1181 when sdk/sentry was not populated. -->
  <Target Name="XrayEnsureSentryArtifacts" BeforeTargets="PrepareForBuild" Condition="'$(UseSentry)'=='true'">
    <PropertyGroup>
      <_SentryLibFullPath>$(SentryLibraryDir)sentry.lib</_SentryLibFullPath>
    </PropertyGroup>
    <Error
      Condition="!Exists('$(_SentryLibFullPath)')"
      Text="Sentry: file not found: $(_SentryLibFullPath). From repo root run: misc\windows\build_sentry_native.ps1 -Platform $(Platform) -Configuration &quot;$(Configuration)&quot; (for Win32 platform use -Platform Win32). Repeat for each VS Configuration you build (Release, Debug, Mixed, Release Master Gold). See sdk\sentry\README.md" />
  </Target>
</Project>
